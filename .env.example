# Frontend (Vite). Copy to .env.local.
# `npx convex dev` writes VITE_CONVEX_URL for you.
VITE_CONVEX_URL=
# From the Clerk dashboard, API keys page. Starts with pk_. Safe to expose.
VITE_CLERK_PUBLISHABLE_KEY=

# Everything else is set on the Convex deployment, NOT in this file:
#   npx convex env set NAME value
# Never put a Clerk secret key (sk_...) anywhere in this project. It is not needed.
