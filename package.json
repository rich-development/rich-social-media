{
  "name": "rich-social-media",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -p . --noEmit && vite build",
    "typecheck": "tsc -p . --noEmit && tsc -p convex --noEmit",
    "test": "vitest run",
    "demo": "vite --config vite.demo.config.ts",
    "setup:keys": "node scripts/setup-keys.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.18.9",
    "convex": "^1.50.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "convex-test": "^0.0.71",
    "jose": "^6.2.17",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
